{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@mesh-to-copycats/minecraft-nbt": ["packages/minecraft-nbt/src/index.ts"],
      "@mesh-to-copycats/mesh": ["packages/mesh/src/index.ts"],
      "@mesh-to-copycats/optimizer": ["packages/optimizer/src/index.ts"],
      "@mesh-to-copycats/palette": ["packages/palette/src/index.ts"],
      "@mesh-to-copycats/pipeline": ["packages/pipeline/src/index.ts"],
      "@mesh-to-copycats/shapes": ["packages/shapes/src/index.ts"],
      "@mesh-to-copycats/shared": ["packages/shared/src/index.ts"],
      "@mesh-to-copycats/voxelizer": ["packages/voxelizer/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "benchmarks/**/*.ts",
    "vitest.config.ts"
  ]
}
