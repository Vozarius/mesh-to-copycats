{
  "name": "mesh-to-copycats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "benchmark": "tsx benchmarks/optimizer.bench.ts",
    "harness": "tsx tools/harness/src/cli.ts",
    "catalog:compile": "node --max-old-space-size=6144 --import tsx tools/mod-extractor/src/compile.ts",
    "catalog:verify": "tsx tools/harness/src/verify-catalog.ts",
    "catalog:fixture": "tsx tools/mod-extractor/src/compile.ts --fixture",
    "web:dev": "pnpm --filter @mesh-to-copycats/web dev",
    "web:build": "pnpm --filter @mesh-to-copycats/web build",
    "materials:verify": "tsx tools/harness/src/verify-materials.ts",
    "neighbors:compile": "node --max-old-space-size=4096 --import tsx tools/mod-extractor/src/compile-neighbors.ts",
    "palette:generate": "tsx tools/palette-generator/src/generate.ts",
    "schematic:verify": "tsx tools/harness/src/verify-schematic.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.32.0",
    "fast-check": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
